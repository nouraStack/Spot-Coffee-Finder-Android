<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_light"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit_preferences"
        android:textColor="@color/burgundy"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="Select your café preferences to get better recommendations"
        android:textColor="@color/text_medium"
        android:textSize="14sp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_preferences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_quiet"
            style="@style/Widget.Spot.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quiet_cafe"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_strong_coffee"
            style="@style/Widget.Spot.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strong_coffee"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_study"
            style="@style/Widget.Spot.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/study_place"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_outdoor"
            style="@style/Widget.Spot.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/outdoor_seating"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_wifi"
            style="@style/Widget.Spot.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wifi_available"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_pet"
            style="@style/Widget.Spot.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pet_friendly"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_specialty"
            style="@style/Widget.Spot.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/specialty_coffee"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_cozy"
            style="@style/Widget.Spot.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cozy_atmosphere"
            android:checkable="true" />
    </com.google.android.material.chip.ChipGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        style="@style/Widget.Spot.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/save" />

</LinearLayout>

